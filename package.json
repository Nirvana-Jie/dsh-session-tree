{
  "name": "@nirvana-jie/dsh-session-tree",
  "version": "0.1.0",
  "description": "Live session lineage and branching inside DeepSeek Harness Web.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Nirvana-Jie",
    "email": "1357711537@qq.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nirvana-Jie/dsh-session-tree.git"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "rimraf lib && tsc -p tsconfig.build.json && tsdown",
    "lint": "oxlint --deny-warnings src tests vitest.config.ts tsdown.config.ts",
    "publint": "publint",
    "prepare": "pnpm build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm test:coverage && pnpm typecheck && pnpm lint && pnpm build && pnpm publint"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.0.1-rc.1 || ^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-runtime": "^0.0.1-rc.1 || ^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.0.1-rc.1 || ^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.0.1-rc.1 || ^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "^0.0.1-rc.1 || ^0.1.0-rc.5",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-locale": { "optional": true },
    "@deepseek-ai/dsh-client-runtime": { "optional": true },
    "@deepseek-ai/dsh-client-ui-conversation": { "optional": true },
    "@deepseek-ai/dsh-client-ui-primitives": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.6",
    "@types/node": "^22.19.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@vitest/coverage-v8": "^4.1.8",
    "jsdom": "^29.1.1",
    "oxlint": "^1.76.0",
    "publint": "^0.3.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.1.2",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@11.7.0"
}
